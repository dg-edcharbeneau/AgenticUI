@page "/agentic-chat"
@using AgenticUI.Web.Formatting
@inject AgentServerConnection Agents
@inject ILoggerFactory LoggerFactory
@implements IDisposable

<PageTitle>Agentic Chat</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Agentic chat</h1>
        <p>
            The simplest AG-UI scenario: a streaming, multi-turn conversation. The Blazor
            <code>&lt;ChatPage&gt;</code> component talks to an <code>IChatClient</code> that is an
            <code>AGUIChatClient</code> pointed at the server's <code>/agentic_chat</code> endpoint.
            Tokens stream in over Server-Sent Events as AG-UI <code>TEXT_MESSAGE_*</code> events,
            then a delegating chat client converts the model's Markdown into structured
            <code>RichTextContent</code> for safe, incremental rendering.
        </p>
    </div>

    <div class="scenario__chat">
        <ChatPage Agent="_agent" Placeholder="Ask me anything…">
            <InputLeadingActions>
                <VoiceControls SpeechTap="_speechTap" />
            </InputLeadingActions>
        </ChatPage>
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;
    private SpeechTapChatClient _speechTap = default!;

    protected override void OnInitialized()
    {
        _speechTap = new SpeechTapChatClient(
            Agents.CreateChatClient("/agentic_chat"),
            LoggerFactory.CreateLogger<SpeechTapChatClient>());
        _chatClient = new FormattedChatClient(_speechTap);
        _agent = new UIAgent(_chatClient);
    }

    public void Dispose()
    {
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
